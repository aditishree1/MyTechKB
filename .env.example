APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data

# ── LLM Provider ─────────────────────────────────────────────
# "ollama" (local, free, default) or "gemini" (free-tier cloud)
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# Google Gemini settings (used when LLM_PROVIDER=gemini)
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Vector Store ─────────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_COLLECTION=mytechkb

# ── Authentication & Multi-Tenancy ───────────────────────────
SESSION_SECRET=change-this-to-a-random-secret-key-in-production

# ── Cloud Deployment & Proxy Support ─────────────────────────
# Optional proxy to bypass YouTube datacenter blocks on Render (free from webshare.io)
# YOUTUBE_PROXY=http://username:password@p.webshare.io:80
# RENDER_EXTERNAL_URL=https://mytechkb.onrender.com

# ── Chunking & Retrieval ─────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120
YOUTUBE_WINDOW_SECONDS=100
RETRIEVE_K=6

# ── Cosmos DB (later swap — leave unset for local $0 use) ────
# VECTOR_STORE=cosmos
# COSMOS_ENDPOINT=
# COSMOS_KEY=
# COSMOS_DATABASE=mytechkb
# COSMOS_CONTAINER=chunks
